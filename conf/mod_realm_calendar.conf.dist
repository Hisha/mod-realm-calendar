#
#    mod-realm-calendar
#    AzerothCore realm/public calendar publisher
#

###################################################################################################
# REALM CALENDAR
#
#    RealmCalendar.Enable
#        Description: Enables automatic realm calendar publication and production admin commands.
#        Default:     1
#
#    RealmCalendar.OutputFile
#        Description: JSON file maintained by the module. Relative paths are resolved from the
#                     worldserver working directory. An absolute web-root path is recommended when
#                     nginx/Apache will serve the feed. Parent directories are created as needed.
#        Default:     "calendar.json"
#
#    RealmCalendar.FutureMonths
#        Description: Number of additional calendar months published after the current month.
#                     12 means the current month plus 12 future months. For example, on Sep 4 2026
#                     the feed covers Sep 1 2026 through Sep 30 2027.
#        Range:       1-36
#        Default:     12
#
#    RealmCalendar.CheckIntervalMinutes
#        Description: How often the module checks whether a new month has started or the output
#                     file has disappeared. Publication also occurs immediately on worldserver
#                     startup and after a config reload.
#        Range:       5-1440
#        Default:     60
#
#    RealmCalendar.Diagnostics
#        Description: Enables development/troubleshooting commands: month, upcoming, holidays,
#                     and inspect. Not required for normal operation.
#        Default:     0
#
#    RealmCalendar.DefaultHorizonDays
#        Description: Number of days shown by `.realmcalendar upcoming` when diagnostics are
#                     enabled and no value is supplied.
#        Default:     30
#
#    RealmCalendar.MaxHorizonDays
#        Description: Maximum value accepted by `.realmcalendar upcoming <days>`.
#        Default:     730
#
###################################################################################################

RealmCalendar.Enable = 1
RealmCalendar.OutputFile = "/mnt/ai_data/linkable/calendar.json"
RealmCalendar.FutureMonths = 12
RealmCalendar.CheckIntervalMinutes = 60
RealmCalendar.Diagnostics = 0
RealmCalendar.DefaultHorizonDays = 30
RealmCalendar.MaxHorizonDays = 730
